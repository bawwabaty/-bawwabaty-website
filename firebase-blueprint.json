{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "name", "role", "createdAt"]
    },
    "Package": {
      "title": "Tour or Umrah Package",
      "description": "A travel package for Umrah or Tourism",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["umrah", "tourism"] },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "duration": { "type": "string" },
        "hotel": { "type": "string" },
        "roomType": { "type": "string" },
        "features": {
          "type": "array",
          "items": { "type": "string" }
        },
        "image": { "type": "string" },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "name", "price", "duration", "hotel", "roomType", "createdAt"]
    },
    "Hotel": {
      "title": "Hotel",
      "description": "A hotel available for booking",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "location": { "type": "string" },
        "rating": { "type": "number" },
        "image": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "location", "rating", "createdAt"]
    },
    "Service": {
      "title": "Service",
      "description": "Additional services like visa, flights, etc.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "description", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/packages/{packageId}": {
      "schema": { "$ref": "#/entities/Package" },
      "description": "Umrah and travel packages"
    },
    "/hotels/{hotelId}": {
      "schema": { "$ref": "#/entities/Hotel" },
      "description": "Hotels details"
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Additional agency services"
    }
  }
}
