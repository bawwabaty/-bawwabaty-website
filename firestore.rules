rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} { 
      allow read, write: if false; 
    }

    // Primitive Helpers
    function isSignedIn() { 
      return request.auth != null; 
    }

    function isAdmin() {
      let email = request.auth.token.email.lower();
      return isSignedIn() && (
        email.matches('.*@bawwabaty.*') || 
        email == 'bawwabaty@gmail.com' ||
        email == 'abdellatifbawwabaty@gmail.com'
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'name', 'role', 'createdAt']) &&
        data.email is string && data.email.size() <= 100 &&
        data.name is string && data.name.size() <= 100 &&
        data.role in ['user', 'admin'] &&
        data.createdAt is timestamp;
    }

    function isValidPackage(data) {
      return data.keys().hasAll(['type', 'name', 'duration', 'createdAt']) &&
        data.type in ['umrah', 'tourism'] &&
        data.name is string && data.name.size() <= 150 &&
        data.duration is string && data.duration.size() <= 50;
    }

    function isValidHotel(data) {
      return data.keys().hasAll(['name', 'location', 'rating', 'createdAt']) &&
        data.name is string && data.name.size() <= 150 &&
        data.location is string && data.location.size() <= 150 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5;
    }

    function isValidService(data) {
      return data.keys().hasAll(['name', 'description', 'createdAt']) &&
        data.name is string && data.name.size() <= 100 &&
        data.description is string && data.description.size() <= 500;
    }

    // Collections
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      
      // Users can create their own profile. Admins can create any.
      allow create: if isSignedIn() && isValidId(userId) && 
                    (request.auth.uid == userId || isAdmin()) &&
                    isValidUser(incoming()) &&
                    (incoming().role == 'user' || isAdmin()); // Users cannot make themselves admin
      
      // Users can update their name. Admins can update anything.
      allow update: if isSignedIn() && isValidId(userId) && (
        isAdmin() || 
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name']))
      );

      allow delete: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hotels/{hotelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /backups/{backupId} {
      allow read, write: if true;
    }
  }
}
